# Copiez ce fichier en .env et adaptez les valeurs.

# Développement : 1. Production : 0
DJANGO_DEBUG=1
# Obligatoire en production. Générer avec :
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production derrière HTTPS, par exemple : https://suivi.mongarage.fr
DJANGO_CSRF_TRUSTED_ORIGINS=
# Mettre 1 si l'appli est derrière un proxy (nginx, Render, Railway…) qui gère le HTTPS
DJANGO_BEHIND_PROXY=0

# Base de données : SQLite par défaut. Pour PostgreSQL :
# DB_ENGINE=postgresql
# DB_NAME=shiftersuivi
# DB_USER=shiftersuivi
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Identité du garage (factures et interface)
GARAGE_NOM=Garage Shifter
GARAGE_ADRESSE=
GARAGE_CODE_POSTAL=
GARAGE_VILLE=
GARAGE_TELEPHONE=
GARAGE_EMAIL=
GARAGE_SIRET=
GARAGE_TVA_INTRACOM=
GARAGE_TAUX_HORAIRE_HT=65.00
